          SQLTask:Connection="{7238C4E9-9406-4CD8-A6E8-21FDF62D5A8A}"
          SQLTask:SqlStatementSource="-- 1. Master Data Tables&#xA;IF OBJECT_ID('stg_Department', 'U') IS NOT NULL TRUNCATE TABLE stg_Department;&#xA;IF OBJECT_ID('stg_Ward', 'U') IS NOT NULL TRUNCATE TABLE stg_Ward;&#xA;IF OBJECT_ID('stg_Bed', 'U') IS NOT NULL TRUNCATE TABLE stg_Bed;&#xA;IF OBJECT_ID('stg_Disease', 'U') IS NOT NULL TRUNCATE TABLE stg_Disease;&#xA;IF OBJECT_ID('stg_Employee', 'U') IS NOT NULL TRUNCATE TABLE stg_Employee;&#xA;IF OBJECT_ID('stg_Doctor', 'U') IS NOT NULL TRUNCATE TABLE stg_Doctor;&#xA;IF OBJECT_ID('stg_Drug', 'U') IS NOT NULL TRUNCATE TABLE stg_Drug;&#xA;&#xA;-- 2. Transactional Data Tables&#xA;IF OBJECT_ID('stg_Admission', 'U') IS NOT NULL TRUNCATE TABLE stg_Admission;&#xA;IF OBJECT_ID('stg_Billing', 'U') IS NOT NULL TRUNCATE TABLE stg_Billing;&#xA;IF OBJECT_ID('stg_Prescription', 'U') IS NOT NULL TRUNCATE TABLE stg_Prescription;&#xA;IF OBJECT_ID('stg_Staff_assignment', 'U') IS NOT NULL TRUNCATE TABLE stg_Staff_assignment;&#xA;IF OBJECT_ID('stg_Drug_inventory', 'U') IS NOT NULL TRUNCATE TABLE stg_Drug_inventory;&#xA;&#xA;-- 3. Flat File Source Tables&#xA;IF OBJECT_ID('stg_Patient', 'U') IS NOT NULL TRUNCATE TABLE stg_Patient;&#xA;IF OBJECT_ID('stg_Insurance_provider', 'U') IS NOT NULL TRUNCATE TABLE stg_Insurance_provider;&#xA;IF OBJECT_ID('stg_Patient_insurance', 'U') IS NOT NULL TRUNCATE TABLE stg_Patient_insurance;&#xA;IF OBJECT_ID('stg_Billing_detail', 'U') IS NOT NULL TRUNCATE TABLE stg_Billing_detail;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

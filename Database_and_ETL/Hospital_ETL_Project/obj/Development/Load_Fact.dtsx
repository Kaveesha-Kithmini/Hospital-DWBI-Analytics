                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    a.admission_id,
    a.patient_id,
    a.department_id, 
    a.ward_id,
    a.bed_id,
    a.disease_id,
    a.admission_date,
    a.discharge_date,
    b.bill_id,
    b.bill_date, 
    b.total_amount,
    b.insurance_covered_amount, 
    b.patient_payable_amount 
FROM stg_Admission a
LEFT JOIN stg_Billing b ON a.admission_id = b.admission_id</property>
